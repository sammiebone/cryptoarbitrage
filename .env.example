# Environment variables for Web3 connection
#
# How to use:
# 1. Make a copy of this file named `.env` in the same directory.
# 2. Fill in your actual data.
#
# DO NOT commit your .env file to version control.

# Your Web3 provider URI (e.g., from Infura or Alchemy)
WEB3_PROVIDER_URI="https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID"

# The private key of the wallet you want to use for trading on DEXs.
# IMPORTANT: This is highly sensitive. Ensure this file is secure.
WALLET_PRIVATE_KEY="YOUR_WALLET_PRIVATE_KEY"
